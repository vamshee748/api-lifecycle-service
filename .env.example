# Environment Configuration for API Lifecycle Service

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/api_lifecycle_db

# =============================================================================
# REDIS CONFIGURATION (Caching)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-secure-redis-password

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================
# Generate a strong secret key (minimum 32 characters)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# Token Expiration Times
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_ENV=development
DEBUG=true

# API Configuration
API_TITLE="API Lifecycle Service"
API_VERSION=1.0.0
API_PORT=8000

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_DEFAULT_TTL=300  # 5 minutes
CACHE_ANALYTICS_TTL=600  # 10 minutes

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=false

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# 1. Change SECRET_KEY to a strong random value
# 2. Set REDIS_PASSWORD for Redis authentication
# 3. Use strong database credentials
# 4. Set APP_ENV=production
# 5. Set DEBUG=false in production
# 6. Configure proper CORS_ORIGINS
# 7. Enable HTTPS/TLS in production
# 8. Configure proper logging
# 9. Set up monitoring and alerting
# 10. Regular backup of database and Redis data
